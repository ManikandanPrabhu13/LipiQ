# LipiQ — AI provider configuration
#
# Copy this file to .env and fill in your credentials.
# Only ONE provider needs to be configured; LipiQ picks the first available.
# OCR, evidence highlighting, editing, and export work WITHOUT any AI provider.
#
# Priority order: Groq > OpenRouter > Ollama
#
# Never commit .env to version control.

# ------------------------------------------------------------------
# OPTION 1 — Groq  (fast, free tier available)
#   https://console.groq.com/keys
# ------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Override the default Groq model (optional):
# GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------
# OPTION 2 — OpenRouter  (access to many models, free credits)
#   https://openrouter.ai/keys
# ------------------------------------------------------------------
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Override the default OpenRouter model (optional):
# OPENROUTER_MODEL=openrouter/auto

# ------------------------------------------------------------------
# OPTION 3 — Ollama  (local, fully offline)
#   Install: https://ollama.com
#   Run:     ollama pull llama3.2
# ------------------------------------------------------------------
# OLLAMA_MODEL=llama3.2

# Override the Ollama server URL if it is not running on localhost (optional):
# OLLAMA_BASE_URL=http://127.0.0.1:11434
